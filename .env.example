# Variáveis do serviço na Railway (nunca coloque valores reais neste arquivo).

# Endereço do Postgres. Na Railway use a referência ao banco do mesmo projeto:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Texto longo e aleatório que assina as sessões de login (obrigatório em produção).
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Acesso do administrador. A senha vale a cada reinício: para trocar, mude a variável.
ADMIN_USER=seu-usuario
ADMIN_PASSWORD=defina-uma-senha-forte
